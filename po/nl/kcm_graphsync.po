msgid "Could not put the link on the clipboard."
msgstr "Kan de link niet op het klembord zetten."

msgctxt "file name of an old version: name, version, extension"
msgid "%1 (version %2)%3"
msgstr "%1 (versie %2)%3"

msgid "The previous version (plasma-onedrive-linux) is still busy; try again in a moment."
msgstr "De vorige versie (plasma-onedrive-linux) is nog bezig; probeer het zo opnieuw."

msgid "Your settings from plasma-onedrive-linux could not be taken over: %1"
msgstr "Je instellingen van plasma-onedrive-linux konden niet worden overgenomen: %1"

msgctxt "name of the personal OneDrive, %1 is the organization"
msgid "OneDrive - %1"
msgstr "OneDrive - %1"

msgctxt "folder name of the personal OneDrive, %1 is the organization"
msgid "OneDrive - %1"
msgstr "OneDrive - %1"

msgid "Organization"
msgstr "Organisatie"

msgid "The client ID looks like 00000000-0000-0000-0000-000000000000. Ask your IT administrator for it."
msgstr "De client-ID ziet eruit als 00000000-0000-0000-0000-000000000000. Vraag je IT-beheerder erom."

msgid "Enter the work e-mail address of the account."
msgstr "Vul het werk-e-mailadres van het account in."

msgid "No connection to Microsoft 365. Check the network and try again."
msgstr "Geen verbinding met Microsoft 365. Controleer het netwerk en probeer het opnieuw."

msgid "No Microsoft 365 organization was found for %1."
msgstr "Er is geen Microsoft 365-organisatie gevonden voor %1."

msgid "The account of this location is no longer on this computer. Sign in to it again in Settings > Accounts."
msgstr "Het account van deze locatie staat niet meer op deze computer. Meld je er opnieuw bij aan via Instellingen > Accounts."

msgid "The app registration is not configured (client and tenant ID)."
msgstr "De app-registratie is niet ingesteld (client- en tenant-ID)."

msgid "Enter your work e-mail address."
msgstr "Vul je zakelijke e-mailadres in."

msgid "That is not a SharePoint address."
msgstr "Dat is geen SharePoint-adres."

msgid "The account of %1 is no longer on this computer. Sign in to it again in Settings > Accounts."
msgstr "Het account van %1 staat niet meer op deze computer. Meld je er opnieuw bij aan via Instellingen > Accounts."

msgid "This link does not contain a SharePoint library."
msgstr "Deze link bevat geen SharePoint-bibliotheek."

msgid "This link is for %1, which is signed out. Sign in to it first."
msgstr "Deze link is voor %1, dat is afgemeld. Meld je daar eerst bij aan."

msgid "The site could not be opened: %1"
msgstr "De site kon niet worden geopend: %1"

msgid "The library could not be opened: %1"
msgstr "De bibliotheek kon niet worden geopend: %1"

msgid "The folder could not be opened: %1"
msgstr "De map kon niet worden geopend: %1"

msgid "Site"
msgstr "Site"

msgid "Library"
msgstr "Bibliotheek"

msgid "Choose a full folder path, such as %1."
msgstr "Kies een volledig mappad, zoals %1."

msgid "%1 cannot be synced as a whole: everything in it would be uploaded. Choose a folder inside it."
msgstr "%1 kan niet als geheel worden gesynchroniseerd: alles daarin zou worden geüpload. Kies een map daarbinnen."

msgid "%1 is already used by another synced library."
msgstr "%1 wordt al gebruikt door een andere gesynchroniseerde bibliotheek."

msgid "The sync service refused this library."
msgstr "De synchronisatieservice heeft deze bibliotheek geweigerd."

msgid "The sync service is not running: %1"
msgstr "De synchronisatieservice draait niet: %1"

msgid "Taking over your settings from plasma-onedrive-linux…"
msgstr "Je instellingen van plasma-onedrive-linux overnemen…"

msgid "Try Again"
msgstr "Opnieuw proberen"

msgid "Waiting for an account"
msgstr "Wacht op een account"

msgctxt "%1 is the account, %2 the organization"
msgid "%1 (%2)"
msgstr "%1 (%2)"

msgid "just now"
msgstr "zojuist"

msgid "1 minute ago"
msgid_plural "%1 minutes ago"
msgstr[0] "1 minuut geleden"
msgstr[1] "%1 minuten geleden"

msgid "1 hour ago"
msgid_plural "%1 hours ago"
msgstr[0] "1 uur geleden"
msgstr[1] "%1 uur geleden"

msgid "The sync service is not running"
msgstr "De synchronisatieservice draait niet"

msgid "Not signed in"
msgstr "Niet aangemeld"

msgid "Syncing is paused until %1"
msgstr "Synchroniseren is gepauzeerd tot %1"

msgid "Syncing is paused"
msgstr "Synchroniseren is gepauzeerd"

msgid "Offline: syncing continues when the network is back"
msgstr "Offline: het synchroniseren gaat verder zodra het netwerk terug is"

msgid "Some locations have a problem"
msgstr "Bij sommige locaties is er een probleem"

msgid "Syncing…"
msgstr "Bezig met synchroniseren…"

msgid "Your files are synced"
msgstr "Je bestanden zijn gesynchroniseerd"

msgid "Nothing is synced yet"
msgstr "Er wordt nog niets gesynchroniseerd"

msgid "Paused"
msgstr "Gepauzeerd"

msgid "Many files were removed here; waiting for your decision"
msgstr "Hier zijn veel bestanden verwijderd; wacht op je beslissing"

msgid "Stopped"
msgstr "Gestopt"

msgid "Signed out: sign in to sync this location again"
msgstr "Afgemeld: meld je aan om deze locatie weer te synchroniseren"

msgid "Up to date, last synced %1"
msgstr "Bijgewerkt, laatst gesynchroniseerd %1"

msgid "Waiting for the first sync"
msgstr "Wacht op de eerste synchronisatie"

msgid "Stop Syncing?"
msgstr "Synchroniseren stoppen?"

msgid "%1 will no longer be synced. The files stay online, and the local copies in %2 are kept as ordinary files."
msgstr "%1 wordt niet meer gesynchroniseerd. De bestanden blijven online staan en de lokale kopieën in %2 blijven bewaard als gewone bestanden."

msgid "Stop Syncing"
msgstr "Synchroniseren stoppen"

msgid "Cancel"
msgstr "Annuleren"

msgid "Sign Out of This Computer?"
msgstr "Afmelden op deze computer?"

msgid "The locations of %1 stop syncing until you sign in again. Your local files are kept."
msgstr "De locaties van %1 worden niet meer gesynchroniseerd tot je je opnieuw aanmeldt. Je lokale bestanden blijven bewaard."

msgid "Syncing stops until you sign in again. Your local files are kept."
msgstr "Het synchroniseren stopt totdat je je opnieuw aanmeldt. Je lokale bestanden blijven bewaard."

msgid "Sign Out"
msgstr "Afmelden"

msgid "Remove Account?"
msgstr "Account verwijderen?"

msgid "%1 is signed out and its locations stop syncing. The files stay online, and the local copies are kept as ordinary files."
msgstr "%1 wordt afgemeld en de locaties ervan worden niet meer gesynchroniseerd. De bestanden blijven online, en de lokale kopieën blijven als gewone bestanden bewaard."

msgid "Remove Account"
msgstr "Account verwijderen"

msgid "Sync"
msgstr "Synchroniseren"

msgid "Accounts"
msgstr "Accounts"

msgid "Notifications"
msgstr "Meldingen"

msgid "Advanced"
msgstr "Geavanceerd"

msgid "About"
msgstr "Over"

msgid "The sync service is not running, so nothing is being synced."
msgstr "De synchronisatieservice draait niet, dus er wordt niets gesynchroniseerd."

msgid "Start"
msgstr "Starten"

msgid "Resume Syncing"
msgstr "Synchroniseren hervatten"

msgid "Pause Syncing"
msgstr "Synchroniseren pauzeren"

msgid "2 Hours"
msgstr "2 uur"

msgid "8 Hours"
msgstr "8 uur"

msgid "24 Hours"
msgstr "24 uur"

msgid "Sync Now"
msgstr "Nu synchroniseren"

msgid "Pause syncing on metered connections (mobile hotspots)"
msgstr "Synchroniseren pauzeren op verbindingen met een datalimiet (mobiele hotspots)"

msgid "Copy Link gives people:"
msgstr "Link kopiëren geeft mensen:"

msgid "View access"
msgstr "Leestoegang"

msgid "Edit access"
msgstr "Bewerktoegang"

msgid "Locations that are syncing"
msgstr "Locaties die worden gesynchroniseerd"

msgid "Add a Library…"
msgstr "Bibliotheek toevoegen…"

msgid "Use the Sync button in SharePoint, or add a library here."
msgstr "Gebruik de knop Synchroniseren in SharePoint of voeg hier een bibliotheek toe."

msgid "Sign In…"
msgstr "Aanmelden…"

msgid "No locations of this account are synced."
msgstr "Er worden geen locaties van dit account gesynchroniseerd."

msgctxt "%1 is a sync location such as OneDrive - Contoso"
msgid "Shortcut in %1"
msgstr "Snelkoppeling in %1"

msgid "1 item"
msgid_plural "%1 items"
msgstr[0] "1 item"
msgstr[1] "%1 items"

msgid "1 folder not synced"
msgid_plural "%1 folders not synced"
msgstr[0] "1 map wordt niet gesynchroniseerd"
msgstr[1] "%1 mappen worden niet gesynchroniseerd"

msgid "1 online only"
msgid_plural "%1 online only"
msgstr[0] "1 alleen online"
msgstr[1] "%1 alleen online"

msgid "Files On-Demand: download files only when you open them"
msgstr "Bestanden op aanvraag: bestanden pas downloaden als je ze opent"

msgid "New files from online appear as placeholders (name.cloud) and are downloaded when you open them. Right-click files or folders in Dolphin to keep them on this computer or to free up space. Switching this off downloads everything again."
msgstr "Nieuwe bestanden van online verschijnen als plaatsvervanger (naam.cloud) en worden gedownload als je ze opent. Klik in Dolphin met rechts op bestanden of mappen om ze op deze computer te houden of om ruimte vrij te maken. Uitschakelen downloadt alles weer."

msgid "To stop syncing it, remove the shortcut in OneDrive online, or delete this folder here."
msgstr "Verwijder de snelkoppeling online in OneDrive, of verwijder deze map hier, om het synchroniseren te stoppen."

msgid "Open Folder"
msgstr "Map openen"

msgid "View Online"
msgstr "Online bekijken"

msgid "Choose Folders…"
msgstr "Mappen kiezen…"

msgctxt "%1 is the account, %2 the organization"
msgid "%1 · %2"
msgstr "%1 · %2"

msgid "Signed in · 1 location"
msgid_plural "Signed in · %1 locations"
msgstr[0] "Aangemeld · 1 locatie"
msgstr[1] "Aangemeld · %1 locaties"

msgid "Signed out: its location is not syncing"
msgid_plural "Signed out: its %1 locations are not syncing"
msgstr[0] "Afgemeld: de locatie ervan wordt niet gesynchroniseerd"
msgstr[1] "Afgemeld: de %1 locaties ervan worden niet gesynchroniseerd"

msgid "Signed out"
msgstr "Afgemeld"

msgid "Used for new locations and for the Sync button in SharePoint."
msgstr "Wordt gebruikt voor nieuwe locaties en voor de knop Synchroniseren in SharePoint."

msgid "%1 of %2 used"
msgstr "%1 van %2 gebruikt"

msgctxt "%1 is the organization"
msgid "Sync OneDrive - %1"
msgstr "OneDrive - %1 synchroniseren"

msgid "Use for New Locations"
msgstr "Gebruiken voor nieuwe locaties"

msgid "Sign Out…"
msgstr "Afmelden…"

msgid "Remove…"
msgstr "Verwijderen…"

msgid "Add Account…"
msgstr "Account toevoegen…"

msgid "Other accounts on this computer"
msgstr "Andere accounts op deze computer"

msgid "Added by another app, such as Graph Mail. Sign in to sync their files too."
msgstr "Toegevoegd door een andere app, zoals Graph Mail. Meld je aan om ook de bestanden ervan te synchroniseren."

msgid "You are notified about sync conflicts, problems, newly synced libraries, many removed files and an expired sign-in. Choose which of these show a popup, play a sound or are only logged."
msgstr "Je krijgt een melding bij synchronisatieconflicten, problemen, nieuw gesynchroniseerde bibliotheken, veel verwijderde bestanden en een verlopen aanmelding. Kies welke hiervan een pop-up tonen, een geluid afspelen of alleen worden vastgelegd."

msgid "Configure Notifications…"
msgstr "Meldingen instellen…"

msgid "Network"
msgstr "Netwerk"

msgid "Download rate:"
msgstr "Downloadsnelheid:"

msgid "Limit to"
msgstr "Beperken tot"

msgctxt "kilobytes per second"
msgid "KB/s"
msgstr "KB/s"

msgid "Upload rate:"
msgstr "Uploadsnelheid:"

msgid "Files Not to Sync"
msgstr "Niet te synchroniseren bestanden"

msgid "Names:"
msgstr "Namen:"

msgid "One per line, for example:\n*.tmp\nnode_modules"
msgstr "Eén per regel, bijvoorbeeld:\n*.tmp\nnode_modules"

msgid "Hidden files and folders (names starting with a dot)"
msgstr "Verborgen bestanden en mappen (namen die met een punt beginnen)"

msgid "These stay on this computer and online as they are, but changes are no longer synced. To keep a whole folder on this computer only, put an empty file named .nosync in it."
msgstr "Deze blijven op deze computer en online zoals ze zijn, maar wijzigingen worden niet meer gesynchroniseerd. Zet een leeg bestand met de naam .nosync in een map om die hele map alleen op deze computer te houden."

msgid "Disk Space"
msgstr "Schijfruimte"

msgid "Always keep free:"
msgstr "Altijd vrij houden:"

msgctxt "megabytes"
msgid "MB"
msgstr "MB"

msgid "App Registration"
msgstr "App-registratie"

msgid "The client ID of your organization's app registration and your organization (tenant). Change these only when your IT administrator asks you to; changing them signs you out of this computer."
msgstr "De client-ID van de app-registratie van je organisatie en je organisatie (tenant). Wijzig deze alleen als je IT-beheerder daarom vraagt; door ze te wijzigen word je op deze computer afgemeld."

msgid "Client ID:"
msgstr "Client-ID:"

msgid "Tenant ID or work e-mail address:"
msgstr "Tenant-ID of zakelijk e-mailadres:"

msgid "Looking up your organization…"
msgstr "Je organisatie opzoeken…"

msgid "Save"
msgstr "Opslaan"

msgid "Saved. Sign in again to continue syncing."
msgstr "Opgeslagen. Meld je opnieuw aan om verder te synchroniseren."

msgid "Troubleshooting"
msgstr "Problemen oplossen"

msgid "Compares every file on this computer with OneDrive and SharePoint again. Use this when something looks out of sync; nothing is deleted by it."
msgstr "Vergelijkt elk bestand op deze computer opnieuw met OneDrive en SharePoint. Gebruik dit als iets niet gesynchroniseerd lijkt; hierbij wordt niets verwijderd."

msgid "Check All Files Again"
msgstr "Alle bestanden opnieuw controleren"

msgid "Checking; this can take a while for large libraries."
msgstr "Bezig met controleren; bij grote bibliotheken kan dit even duren."

msgid "Graph Sync"
msgstr "Graph Sync"

msgid "Version %1"
msgstr "Versie %1"

msgid "License:"
msgstr "Licentie:"

msgid "GNU General Public License, version 3 or later"
msgstr "GNU General Public License, versie 3 of later"

msgid "Sync state:"
msgstr "Synchronisatiestatus:"

msgid "Logs:"
msgstr "Logboeken:"

msgid "Graph Sync is not affiliated with or endorsed by Microsoft. OneDrive and SharePoint are trademarks of Microsoft Corporation."
msgstr "Graph Sync is niet verbonden aan of goedgekeurd door Microsoft. OneDrive en SharePoint zijn handelsmerken van Microsoft Corporation."
