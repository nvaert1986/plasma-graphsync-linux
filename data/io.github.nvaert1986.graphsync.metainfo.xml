  <name>Graph Sync</name>
  <summary>Sync client for Microsoft OneDrive and SharePoint</summary>
  <description>
    <p>
      Graph Sync keeps OneDrive for Business and SharePoint document libraries in
      folders on your computer, with a system tray applet, settings in System Settings and
      support for the Sync button in SharePoint.
    </p>
    <p>
      It is not affiliated with or endorsed by Microsoft. OneDrive and SharePoint are trademarks
      of Microsoft Corporation.
    </p>
  </description>
  <launchable type="desktop-id">io.github.nvaert1986.graphsync.desktop</launchable>
  <url type="homepage">https://github.com/nvaert1986/plasma-graphsync-linux</url>
  <developer id="io.github.nvaert1986">
    <name>plasma-graphsync-linux contributors</name>
  </developer>
  <provides>
    <binary>plasma-graphsync-linux</binary>
    <binary>graphsyncd</binary>
    <binary>graphsyncctl</binary>
  </provides>
